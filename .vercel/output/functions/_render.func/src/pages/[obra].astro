---
import Layout from "../layouts/Layout.astro";
import { obras } from "../data/obras";

export const prerender = false;
const { obra } = Astro.params;
const info = obras.find(o => o.id === obra);
if (!info) {
  return Astro.redirect("/404");
}
---

<Layout title={`${info.serie} — Oscar Bautista`}>
  <main class="m-auto max-w-5xl px-5 py-16">

    <div class="mb-10">
      <a href="/obra" class="inline-flex items-center gap-2 text-gray-400 hover:text-[#1A3A6E] text-xs uppercase tracking-widest transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
        </svg>
        Volver a obras
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 items-start">

      <div class="md:col-span-3">
        <picture class="block">
          <img
            class="w-full rounded shadow-2xl"
            src={info.img}
            alt={`${info.serie} — Oscar Bautista`}
            style={`view-transition-name: obra-${info.id}`}
          />
        </picture>
      </div>

      <aside class="md:col-span-2 md:sticky md:top-24">
        <span class="text-[#1A3A6E] uppercase tracking-[0.4em] text-xs block mb-4">Serie</span>
        <h1 class="display-font text-3xl md:text-4xl font-bold mb-2 leading-tight">{info.serie}</h1>
        <div class="w-12 h-px bg-[#1A3A6E] mb-8"></div>

        <dl class="space-y-5">
          {info.tecnica && (
            <div>
              <dt class="text-xs uppercase tracking-widest text-gray-400 mb-1">Técnica</dt>
              <dd class="text-gray-800 font-medium">{info.tecnica}</dd>
            </div>
          )}
          {info.formato && (
            <div>
              <dt class="text-xs uppercase tracking-widest text-gray-400 mb-1">Formato</dt>
              <dd class="text-gray-800 font-medium">{info.formato}</dd>
            </div>
          )}
          {info.año && (
            <div>
              <dt class="text-xs uppercase tracking-widest text-gray-400 mb-1">Año</dt>
              <dd class="text-gray-800 font-medium">{info.año}</dd>
            </div>
          )}
        </dl>

        <div class="mt-10 pt-8 border-t border-gray-200">
          <p class="text-sm text-gray-500 mb-4">¿Te interesa esta obra?</p>
          <a
            href="/contacto"
            class="inline-flex items-center gap-2 bg-[#1A3A6E] text-white px-7 py-3 text-xs uppercase tracking-widest hover:bg-[#1C1C1C] transition-colors duration-300"
          >
            Contactar al artista
          </a>
        </div>
      </aside>

    </div>
  </main>
</Layout>

<style>
  .display-font {
    font-family: 'Playfair Display', Georgia, serif;
  }
</style>
