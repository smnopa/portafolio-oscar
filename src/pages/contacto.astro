---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto — Oscar Bautista">
  <main class="py-16 px-5">

    <div class="text-center mb-14">
      <span class="text-[#1A3A6E] uppercase tracking-[0.4em] text-xs block mb-4">Hablemos</span>
      <h1 class="display-font text-5xl md:text-6xl font-bold mb-4">Contacto</h1>
      <div class="w-16 h-px bg-[#1A3A6E] mx-auto mb-6"></div>
      <p class="text-gray-500 max-w-md mx-auto text-sm leading-relaxed">
        ¿Interesado en una obra, en los talleres, o simplemente quieres saludar? Escríbele directamente.
      </p>
    </div>

    <div class="max-w-xl mx-auto bg-white rounded shadow-sm p-8 md:p-12">
      <form action="https://formsubmit.co/oscarbautistacobos@gmail.com" method="POST" class="space-y-7">

        <div>
          <label for="email" class="block text-xs uppercase tracking-widest text-gray-500 mb-2">Tu correo</label>
          <input
            type="email"
            name="email"
            id="email"
            placeholder="nombre@correo.com"
            required
            class="w-full border border-gray-200 rounded px-4 py-3 text-sm text-gray-800 bg-white focus:outline-none focus:border-[#1A3A6E] transition-colors placeholder-gray-300"
          />
        </div>

        <div>
          <label for="subject" class="block text-xs uppercase tracking-widest text-gray-500 mb-2">Asunto</label>
          <input
            type="text"
            name="subject"
            id="subject"
            placeholder="¿En qué puedo ayudarte?"
            required
            class="w-full border border-gray-200 rounded px-4 py-3 text-sm text-gray-800 bg-white focus:outline-none focus:border-[#1A3A6E] transition-colors placeholder-gray-300"
          />
        </div>

        <div>
          <label for="message" class="block text-xs uppercase tracking-widest text-gray-500 mb-2">Mensaje</label>
          <textarea
            name="message"
            id="message"
            rows="6"
            placeholder="Escribe tu mensaje aquí..."
            class="w-full border border-gray-200 rounded px-4 py-3 text-sm text-gray-800 bg-white focus:outline-none focus:border-[#1A3A6E] transition-colors placeholder-gray-300 resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-[#1A3A6E] text-white py-3.5 text-xs uppercase tracking-[0.3em] font-semibold hover:bg-[#1C1C1C] transition-colors duration-300 rounded"
        >
          Enviar mensaje
        </button>

      </form>
    </div>

  </main>
</Layout>

<style>
  .display-font {
    font-family: 'Playfair Display', Georgia, serif;
  }
</style>
